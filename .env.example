# ==============================================================================
# LLM Pulse Gateway - Environment Configuration (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Settings
APP_NAME=LLM Pulse Gateway
DEBUG=True
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Redis Cache Service

# Qdrant Vector Database (optional — the cache falls back to an in-memory index)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Semantic Cache / Embeddings (served by Ollama)
EMBEDDING_MODEL=nomic-embed-text
CACHE_COLLECTION=semantic_cache
CACHE_SIMILARITY_THRESHOLD=0.90

# Ollama Local SLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Context window allocated per request (Ollama's default is the model's full 131k)
OLLAMA_NUM_CTX=4096
# How long Ollama keeps the model in RAM after the last request (default 5m)
OLLAMA_KEEP_ALIVE=30m

# Inference budget in seconds; a cold local model needs time to load into VRAM
INFERENCE_TIMEOUT_SECONDS=90

# Cloud LLM Providers (Optional for cloud fortress fallback)
# Gemini is the first cloud hop; leave empty to stay fully local/offline.
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# DeepSeek is called directly (OpenAI-compatible API), so it is unaffected by
# OPENAI_API_KEY and needs no LiteLLM.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_DEEPSEEK_MODEL=deepseek-chat
